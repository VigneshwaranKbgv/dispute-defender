# Copy to .env and fill in. Never commit .env.

# --- PayPal Sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox) ---
# Use a US sandbox business account. The app refuses to start against a non-sandbox URL.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID from the PayPal developer dashboard (needed to verify webhook signatures).
# Leave empty to run without webhooks; cases are then added by ID.
PAYPAL_WEBHOOK_ID=

# --- AI provider: fill ONE key. AI_PROVIDER = anthropic | gemini | openai-compatible ---
AI_PROVIDER=gemini
# Optional. Defaults: gemini-2.5-flash (gemini), claude-sonnet-5-5 (anthropic). Required for openai-compatible.
AI_MODEL=
# Optional second model tried if the first is overloaded or times out (gemini default: gemini-flash-lite-latest).
AI_FALLBACK_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=

# --- App ---
PORT=3000
# Optional shared password for a hosted demo. Leave empty for no login screen.
APP_PASSWORD=
# Optional: dispute ID behind the "Add the demo case" button.
DEMO_CASE_ID=PP-R-BYM-10198930
# Optional: where db.json and evidence files are stored (default ./data).
DATA_DIR=

# --- Sandbox buyer test account (for the README / judges; sandbox only, not used by the app) ---
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=
