{
  "name": "dispute-defender",
  "version": "1.0.0",
  "description": "Evidence-first PayPal dispute defence for small sellers: AI-scored cases, missing-proof checklist, deadline tracking, human-approved responses.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "sandbox:create-order": "node --env-file=.env --import tsx scripts/create-order.ts",
    "sandbox:capture-order": "node --env-file=.env --import tsx scripts/capture-order.ts",
    "sandbox:read-dispute": "node --env-file=.env --import tsx scripts/read-dispute.ts"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "express": "^5.3.0",
    "htm": "^3.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
